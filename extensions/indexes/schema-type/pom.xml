<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.exist-db</groupId>
        <artifactId>exist-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../../exist-parent</relativePath>
    </parent>

    <artifactId>exist-index-schema-type</artifactId>
    <packaging>jar</packaging>

    <name>eXist-db Schema Type Index</name>
    <description>eXist-db NoSQL Database Schema Type Index</description>

    <scm>
        <connection>scm:git:https://github.com/exist-db/exist.git</connection>
        <developerConnection>scm:git:https://github.com/exist-db/exist.git</developerConnection>
        <url>scm:git:https://github.com/exist-db/exist.git</url>
      <tag>HEAD</tag>
  </scm>

    <properties>
        <!--
            The FpML confirmation view (schemas and examples) for FpmlEndToEndTest, downloaded rather than committed
            (see src/test/resources/fpml/README.md). The build only downloads the archive; the test verifies its SHA-256
            and unpacks it, and skips itself (never failing the build) when the archive is missing or does not match.
            -Dfpml.skip=true, -DskipTests and -Dmaven.test.skip=true skip the download.
        -->
        <fpml.version>5-12</fpml.version>
        <fpml.url>https://www.fpml.org/spec/fpml-5-12-4-rec-1/xml/confirmation-5-12_xml.zip</fpml.url>
        <fpml.sha256>90c091f1137339cd5debfb396bc0b943d023a09f4395246ebb4bbd3d84b3b6c9</fpml.sha256>
        <fpml.dir>${project.build.directory}/fpml</fpml.dir>
        <fpml.archive>confirmation-${fpml.version}_xml.zip</fpml.archive>
        <fpml.skip>false</fpml.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.exist-db</groupId>
            <artifactId>exist-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>exist-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>
        <dependency>
            <!-- the maps of the schema: module's functions -->
            <groupId>io.lacuna</groupId>
            <artifactId>bifurcan</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>
        <dependency>
            <!-- the default collation of a query (TypedRangeLookup answers string comparisons by codepoint only) -->
            <groupId>com.ibm.icu</groupId>
            <artifactId>icu4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.exist-db.thirdparty.xerces</groupId>
            <artifactId>xercesImpl</artifactId>
            <classifier>jdk14-xml-schema-1.1</classifier>
            <exclusions>
                <exclusion> <!-- conflicts with Java 17's javax.xml module -->
                    <groupId>xml-apis</groupId>
                    <artifactId>xml-apis</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <filtering>false</filtering>
            </testResource>
            <testResource>
                <directory>src/test/resources-filtered</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>*.xsl</exclude>
                </excludes>
            </testResource>
            <testResource>
                <directory>${project.build.directory}/generated-test-resources</directory>
                <filtering>true</filtering>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- the schema fixtures shared with exist-core's tests, read by src/test/xquery/schema-type/fixtures.xqm -->
                        <schema-type.fixtures.dir>${project.basedir}/../../../exist-core/src/test/resources/org/exist/xquery/schema/fixtures</schema-type.fixtures.dir>
                        <!-- the downloaded FpML confirmation view, verified and unpacked by FpmlEndToEndTest -->
                        <fpml.dir>${fpml.dir}</fpml.dir>
                        <fpml.archive>${fpml.dir}/${fpml.archive}</fpml.archive>
                        <fpml.sha256>${fpml.sha256}</fpml.sha256>
                        <fpml.url>${fpml.url}</fpml.url>
                        <fpml.version>${fpml.version}</fpml.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <executions>
                    <execution>
                        <id>fpml-confirmation-view</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <skip>${fpml.skip}</skip>
                            <url>${fpml.url}</url>
                            <!--
                                download only: the plugin fails the build on a checksum mismatch whatever failOnError
                                says, so FpmlEndToEndTest checks fpml.sha256 and unpacks the archive itself
                            -->
                            <readTimeOut>120000</readTimeOut>
                            <retries>2</retries>
                            <!-- no network: the test skips itself instead of failing the build -->
                            <failOnError>false</failOnError>
                            <unpack>false</unpack>
                            <outputDirectory>${fpml.dir}</outputDirectory>
                            <outputFileName>${fpml.archive}</outputFileName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- no FpML download when the tests are skipped -->
        <profile>
            <id>fpml-skip-with-skip-tests</id>
            <activation>
                <property>
                    <name>skipTests</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <fpml.skip>true</fpml.skip>
            </properties>
        </profile>
        <profile>
            <id>fpml-skip-with-maven-test-skip</id>
            <activation>
                <property>
                    <name>maven.test.skip</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <fpml.skip>true</fpml.skip>
            </properties>
        </profile>
    </profiles>

</project>
