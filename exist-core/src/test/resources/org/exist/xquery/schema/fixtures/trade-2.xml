<!-- values whose typed order, equality and arithmetic differ from their string (untyped) ones -->
<t:trades xmlns:t="urn:example:trade">
    <t:trade>
        <t:swap/>
        <t:notional>
            <t:amount>10</t:amount>
            <t:currency>EUR</t:currency>
        </t:notional>
        <t:fee>
            <t:amount>1.0</t:amount>
        </t:fee>
        <t:rates>1.5 2.5</t:rates>
    </t:trade>
    <t:trade>
        <t:swap/>
        <t:notional>
            <t:amount>9</t:amount>
            <t:currency>EUR</t:currency>
        </t:notional>
        <t:fee>
            <t:amount>1</t:amount>
        </t:fee>
    </t:trade>
</t:trades>
