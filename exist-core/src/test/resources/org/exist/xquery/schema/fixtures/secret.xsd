<!-- a schema only its owner may read (import schema access tests) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:s="urn:example:secret"
           targetNamespace="urn:example:secret"
           elementFormDefault="qualified">

    <xs:simpleType name="Code">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{4}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="secret" type="s:Code"/>

</xs:schema>
